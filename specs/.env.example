# Virtual Lab Studio — environment template
# Copy only non-secret defaults into source control. Put real secrets in Replit Secrets.

APP_NAME=Virtual Lab Studio
APP_ENV=development
APP_BASE_URL=http://localhost:8000
API_PREFIX=/api/v1
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
TRUSTED_HOSTS=localhost,127.0.0.1

# Database — Replit Database provides DATABASE_URL in deployed environments.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/virtual_lab_studio
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Authentication
# Preferred production option: Clerk. A Replit Auth adapter may be implemented as an alternative.
AUTH_PROVIDER=dev
DEV_AUTH_ENABLED=true
DEV_AUTH_EMAIL=researcher@example.test
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER=
VITE_CLERK_PUBLISHABLE_KEY=

# Application encryption. Generate a strong 32-byte base64 key and store only in Replit Secrets.
APP_ENCRYPTION_KEY=
SECRET_REDACTION_ENABLED=true

# Provider defaults
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
DEFAULT_PROVIDER=demo
DEFAULT_MODEL=demo-research-v1

# OpenAI-compatible/local providers are configured per workspace in the UI.
# Never use localhost here from a deployed Replit app unless the provider runs in the same instance.
ALLOW_PRIVATE_PROVIDER_HOSTS=false
PROVIDER_CONNECT_TIMEOUT_SECONDS=10
PROVIDER_READ_TIMEOUT_SECONDS=180
PROVIDER_MAX_RETRIES=3

# NCBI / PubMed Central
NCBI_API_KEY=
NCBI_EMAIL=
NCBI_TOOL_NAME=virtual-lab-studio
PMC_MAX_RESULTS_PER_CALL=5
PMC_MAX_ARTICLE_CHARS=120000

# Replit App Storage / object storage adapter
STORAGE_PROVIDER=replit
STORAGE_BUCKET=
STORAGE_PREFIX=virtual-lab-studio
MAX_UPLOAD_BYTES=52428800
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.md,.markdown,.txt,.json,.csv

# Run worker, queue, and streaming
RUN_WORKER_ENABLED=true
RUN_WORKER_POLL_SECONDS=1
RUN_LEASE_SECONDS=90
RUN_HEARTBEAT_SECONDS=20
RUN_EVENT_BATCH_SIZE=100
SSE_HEARTBEAT_SECONDS=15
RUN_MAX_ROUNDS=12
RUN_MAX_AGENTS=12
RUN_MAX_PROVIDER_CALLS=200
RUN_MAX_TOOL_CALLS=100
RUN_DEFAULT_MAX_WALL_SECONDS=3600
RUN_DEFAULT_MAX_INPUT_TOKENS=500000
RUN_DEFAULT_MAX_OUTPUT_TOKENS=100000
RUN_DEFAULT_MAX_COST_USD=25

# Rate limiting and security
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
LOGIN_RATE_LIMIT_REQUESTS_PER_MINUTE=20
CONTENT_SECURITY_POLICY_ENABLED=true
SECURE_COOKIES=false
AUDIT_RETENTION_DAYS=2555
TRANSCRIPT_RETENTION_DAYS=2555

# Frontend production assets
STATIC_DIR=frontend/dist
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=Virtual Lab Studio
VITE_DEMO_MODE=true

# Testing
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/virtual_lab_studio_test
E2E_BASE_URL=http://localhost:8000
