{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virtual-lab-studio.local/schemas/meeting-summary.schema.json",
  "title": "Virtual Lab Studio Structured Meeting Summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agenda",
    "executive_summary",
    "recommendation",
    "question_answers",
    "evidence",
    "assumptions",
    "disagreements",
    "risks_and_limitations",
    "next_steps",
    "confidence",
    "disclosure"
  ],
  "properties": {
    "agenda": {
      "type": "string",
      "minLength": 1
    },
    "executive_summary": {
      "type": "string",
      "minLength": 1
    },
    "role_contributions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent_id",
          "agent_title",
          "contribution"
        ],
        "properties": {
          "agent_id": {
            "type": "string"
          },
          "agent_title": {
            "type": "string"
          },
          "contribution": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "rationale",
        "conditions"
      ],
      "properties": {
        "decision": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "alternatives_considered": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "alternative",
              "reason_not_selected"
            ],
            "properties": {
              "alternative": {
                "type": "string"
              },
              "reason_not_selected": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "question_answers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "answer",
          "evidence_ids",
          "confidence"
        ],
        "properties": {
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "open_issue": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "claim",
          "support_type"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "claim": {
            "type": "string"
          },
          "support_type": {
            "type": "string",
            "enum": [
              "supports",
              "contradicts",
              "context",
              "uncertain"
            ]
          },
          "locator": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assumption",
          "impact",
          "validation"
        ],
        "properties": {
          "assumption": {
            "type": "string"
          },
          "impact": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "validation": {
            "type": "string"
          }
        }
      }
    },
    "disagreements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "positions",
          "resolution_status"
        ],
        "properties": {
          "topic": {
            "type": "string"
          },
          "positions": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "agent_title",
                "position"
              ],
              "properties": {
                "agent_title": {
                  "type": "string"
                },
                "position": {
                  "type": "string"
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "resolution_status": {
            "type": "string",
            "enum": [
              "resolved",
              "lead_decision",
              "unresolved",
              "needs_evidence"
            ]
          },
          "resolution": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "risks_and_limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "risk",
          "severity",
          "likelihood",
          "mitigation"
        ],
        "properties": {
          "risk": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "likelihood": {
            "type": "string",
            "enum": [
              "unlikely",
              "possible",
              "likely"
            ]
          },
          "mitigation": {
            "type": "string"
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "owner_role",
          "acceptance_criterion",
          "priority"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "owner_role": {
            "type": "string"
          },
          "acceptance_criterion": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "now",
              "next",
              "later"
            ]
          },
          "due_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          }
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall",
        "basis",
        "uncertainty"
      ],
      "properties": {
        "overall": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "basis": {
          "type": "string"
        },
        "uncertainty": {
          "type": "string"
        }
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_generated",
        "human_review_required",
        "limitations"
      ],
      "properties": {
        "model_generated": {
          "const": true
        },
        "human_review_required": {
          "const": true
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}