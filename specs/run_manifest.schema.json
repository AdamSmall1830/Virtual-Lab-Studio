{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virtual-lab-studio.local/schemas/run-manifest.schema.json",
  "title": "Virtual Lab Studio Run Provenance Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "run",
    "software",
    "meeting",
    "agents",
    "evidence",
    "providers",
    "tools",
    "usage",
    "interventions",
    "lineage",
    "integrity"
  ],
  "properties": {
    "manifest_version": {
      "type": "string",
      "const": "1.0"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "workspace_id",
        "project_id",
        "status",
        "created_at",
        "started_at",
        "completed_at"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "failed",
            "cancelled",
            "budget_stopped"
          ]
        },
        "created_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "review_status": {
          "type": "string",
          "enum": [
            "unreviewed",
            "in_review",
            "approved",
            "changes_requested",
            "rejected"
          ]
        },
        "demo_mode": {
          "type": "boolean"
        }
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application_version",
        "git_commit",
        "upstream_package"
      ],
      "properties": {
        "application_version": {
          "type": "string"
        },
        "git_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "python_version": {
          "type": "string"
        },
        "database_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "upstream_package": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "source_repository",
            "version_or_commit",
            "license"
          ],
          "properties": {
            "name": {
              "const": "virtual-lab"
            },
            "source_repository": {
              "type": "string"
            },
            "version_or_commit": {
              "type": "string"
            },
            "license": {
              "const": "MIT"
            }
          }
        }
      }
    },
    "meeting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition_id",
        "definition_sha256",
        "meeting_type",
        "agenda",
        "questions",
        "rules",
        "rounds",
        "temperature"
      ],
      "properties": {
        "definition_id": {
          "type": "string"
        },
        "definition_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "meeting_type": {
          "type": "string",
          "enum": [
            "team",
            "individual",
            "ensemble_merge"
          ]
        },
        "agenda": {
          "type": "string"
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rounds": {
          "type": "integer",
          "minimum": 1
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "budget": {
          "type": "object"
        }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent_id",
          "version_id",
          "title",
          "role_type",
          "system_prompt_sha256",
          "provider_config_id",
          "model_id"
        ],
        "properties": {
          "agent_id": {
            "type": "string"
          },
          "version_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "role_type": {
            "type": "string",
            "enum": [
              "lead",
              "member",
              "expert",
              "critic",
              "merger"
            ]
          },
          "system_prompt_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "provider_config_id": {
            "type": "string"
          },
          "model_id": {
            "type": "string"
          },
          "temperature_override": {
            "type": [
              "number",
              "null"
            ]
          },
          "tool_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "source_type",
          "title",
          "content_sha256",
          "included_chunk_ids"
        ],
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "citation": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "included_chunk_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "retrieved_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider_config_id",
          "provider_type",
          "endpoint_fingerprint"
        ],
        "properties": {
          "provider_config_id": {
            "type": "string"
          },
          "provider_type": {
            "type": "string"
          },
          "endpoint_fingerprint": {
            "type": "string"
          },
          "organization": {
            "type": [
              "string",
              "null"
            ]
          },
          "secret_reference": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool_id",
          "name",
          "version",
          "policy"
        ],
        "properties": {
          "tool_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "policy": {
            "type": "object"
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_calls",
        "tool_calls",
        "input_tokens",
        "output_tokens",
        "cost_usd"
      ],
      "properties": {
        "provider_calls": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cached_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "wall_seconds": {
          "type": "number",
          "minimum": 0
        },
        "by_model": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "interventions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "actor_id",
          "kind",
          "created_at",
          "content_sha256"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "actor_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "pause",
              "resume",
              "cancel",
              "instruction",
              "evidence_addition",
              "approval"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "recursive_execution": {
      "description": "Participant turns delegated to an enrolled external worker. Always present on manifests written by v0.1.0 and later, with job_count 0 when no participant ran off-host, so absence of recursive work is a statement rather than a gap. The node tree, event log and per-job results live in the reproducibility packet and are bound here by digest.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_count",
        "node_count",
        "simulated",
        "usage",
        "workers",
        "jobs",
        "packet_digests"
      ],
      "properties": {
        "job_count": {
          "type": "integer",
          "minimum": 0
        },
        "node_count": {
          "type": "integer",
          "minimum": 0
        },
        "simulated": {
          "type": "boolean"
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "job_count",
            "node_count",
            "model_calls",
            "input_tokens",
            "cached_input_tokens",
            "output_tokens",
            "cost_usd"
          ],
          "properties": {
            "job_count": {
              "type": "integer",
              "minimum": 0
            },
            "node_count": {
              "type": "integer",
              "minimum": 0
            },
            "model_calls": {
              "type": "integer",
              "minimum": 0
            },
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "cached_input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "cost_usd": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "workers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "worker_id",
              "display_name",
              "status"
            ],
            "properties": {
              "worker_id": {
                "type": "string"
              },
              "display_name": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "sandbox_mode": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "adapter_version": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "prime_agent_version": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "capability_profiles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "enrolled_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "revoked_at": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "jobs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "job_id",
              "run_turn_id",
              "agent_version_id",
              "status",
              "model_key",
              "capability_profile",
              "limits",
              "request_sha256",
              "usage",
              "node_count"
            ],
            "properties": {
              "job_id": {
                "type": "string"
              },
              "run_turn_id": {
                "type": "string"
              },
              "agent_version_id": {
                "type": "string"
              },
              "worker_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "requested_worker_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "type": "string"
              },
              "attempt_count": {
                "type": "integer",
                "minimum": 0
              },
              "max_attempts": {
                "type": "integer",
                "minimum": 0
              },
              "model_key": {
                "type": "string"
              },
              "child_model_key": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "capability_profile": {
                "type": "string"
              },
              "limits": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "max_children",
                  "max_depth",
                  "max_agent_turns",
                  "max_tokens",
                  "max_runtime_seconds",
                  "max_cost_usd"
                ],
                "properties": {
                  "max_children": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "max_depth": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "max_agent_turns": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "max_tokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "max_runtime_seconds": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "max_cost_usd": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              },
              "request_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "result_sha256": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "request": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "schema_version": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "meeting_definition_sha256": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "turn_sequence": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "round_number": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "capability_profile": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "allowed_skill_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "allow_web": {
                    "type": "boolean"
                  },
                  "evidence_keys": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "usage": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "model_calls",
                  "input_tokens",
                  "cached_input_tokens",
                  "output_tokens",
                  "cost_usd"
                ],
                "properties": {
                  "model_calls": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "input_tokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "cached_input_tokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "output_tokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "cost_usd": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              "node_count": {
                "type": "integer",
                "minimum": 0
              },
              "started_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "completed_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "failure_code": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "failure_safe_message": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "packet_digests": {
          "description": "SHA-256 of each recursive file in the reproducibility packet, keyed by its path inside the packet.",
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_run_ids",
        "source_run_ids",
        "ensemble_member_run_ids"
      ],
      "properties": {
        "parent_run_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_run_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ensemble_member_run_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "merge_run_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transcript_sha256",
        "summary_sha256",
        "manifest_payload_sha256"
      ],
      "properties": {
        "transcript_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "summary_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "manifest_payload_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "signature": {
          "type": [
            "string",
            "null"
          ]
        },
        "signature_algorithm": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}