# Virtual Lab Studio — example environment
#
# Copy to .env for a local checkout. On Replit these are provisioned as
# workspace secrets instead; do not paste real values into this file.

# --- Core -----------------------------------------------------------------
# "development" unlocks passwordless dev-login and non-secure cookies. It is
# ignored inside a Replit deployment, which always behaves as production.
APP_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/virtual_lab_studio
# Long random string. Also derives the key that encrypts provider API keys at
# rest, so rotating it invalidates every stored provider secret.
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=vls_session
SESSION_MAX_AGE_SECONDS=1209600

# --- Managed identity provider (Clerk) ------------------------------------
# Empty CLERK_SECRET_KEY disables Clerk sign-in.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Frontend build-time copy of the publishable key.
VITE_CLERK_PUBLISHABLE_KEY=

# --- Run worker -----------------------------------------------------------
RUN_WORKER_ENABLED=true
WORKER_ID=worker-1
WORKER_POLL_SECONDS=1.0
WORKER_LEASE_SECONDS=90
# Adds human-scale pacing to demo-provider runs so the live room is readable.
DEMO_LATENCY_ENABLED=true

# --- Replit AI Integrations (optional, zero-key OpenAI-compatible) --------
# Provisioned automatically when the integration is added. Empty = unavailable.
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=
# Comma-separated emails allowed to spend the workspace owner's Replit credits
# via the zero-key option. Empty = nobody.
REPLIT_AI_ALLOWED_EMAILS=

# --- Object storage -------------------------------------------------------
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# --- Optional Recursive Agent (Beta) --------------------------------------
# A participant may optionally be executed by an external worker running on the
# user's own machine rather than by a direct provider completion. Off by
# default. Enabling it requires a pepper of at least 32 characters; the app
# refuses to start otherwise rather than quietly disabling the feature.
#
# The worker is authenticated but NOT trusted: read docs/WORKER_SECURITY_MODEL.md
# before enabling this on a deployment other people use, and
# docs/WORKER_SETUP.md to run a worker on your own machine.
#
# With this off the routes are not registered at all -- they 404 like any
# unknown URL and do not appear in the OpenAPI document.
RECURSIVE_AGENTS_ENABLED=false
# Deterministic in-process simulator, for exercising the broker without real
# hardware. Never active inside a Replit deployment, whatever this is set to.
RECURSIVE_AGENTS_ALLOW_FAKE_WORKER=false
# Keyed-hash pepper for worker credentials. Rotating it revokes every worker.
# Generate one with: openssl rand -hex 32
RECURSIVE_WORKER_TOKEN_PEPPER=replace-with-a-long-random-secret

# Worker liveness and enrollment.
RECURSIVE_WORKER_OFFLINE_AFTER_SECONDS=90
RECURSIVE_WORKER_ENROLLMENT_TTL_SECONDS=900

# Job leasing and request ceilings.
RECURSIVE_JOB_LEASE_SECONDS=60
RECURSIVE_JOB_MAX_ATTEMPTS=3
RECURSIVE_JOB_EVENT_BATCH_MAX=100
RECURSIVE_JOB_EVENT_BODY_MAX_BYTES=262144
RECURSIVE_JOB_RESULT_BODY_MAX_BYTES=1048576

# Per-job budgets. DEFAULT_ seeds a new participant configuration; HARD_ is the
# deployment policy ceiling a workspace cannot exceed.
RECURSIVE_JOB_DEFAULT_MAX_RUNTIME_SECONDS=900
RECURSIVE_JOB_HARD_MAX_RUNTIME_SECONDS=3600
RECURSIVE_JOB_DEFAULT_MAX_TOKENS=32000
RECURSIVE_JOB_HARD_MAX_TOKENS=200000
RECURSIVE_JOB_DEFAULT_MAX_CHILDREN=3
RECURSIVE_JOB_HARD_MAX_CHILDREN=8
RECURSIVE_JOB_DEFAULT_MAX_DEPTH=1
RECURSIVE_JOB_HARD_MAX_DEPTH=2
RECURSIVE_JOB_DEFAULT_MAX_AGENT_TURNS=8
RECURSIVE_JOB_HARD_MAX_AGENT_TURNS=20
RECURSIVE_JOB_DEFAULT_MAX_COST_USD=2.0
RECURSIVE_JOB_HARD_MAX_COST_USD=25.0
