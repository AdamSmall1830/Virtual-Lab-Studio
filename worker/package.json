{
  "name": "@virtual-lab-studio/bridge-worker",
  "version": "0.1.0",
  "description": "Prime Agent bridge worker for Virtual Lab Studio. Runs on the researcher's own machine, leases recursive-agent jobs over outbound HTTPS and executes them in a disposable restricted container using local models.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "vls-worker": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "docker",
    "skills",
    "worker.config.example.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "start": "node dist/index.js run",
    "doctor": "node dist/index.js doctor"
  },
  "dependencies": {},
  "optionalDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "~5.9.3"
  }
}
