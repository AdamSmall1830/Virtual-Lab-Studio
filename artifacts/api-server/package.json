{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash ../../backend/ensure_venv.sh && APP_ENV=development exec ../../backend/.venv/bin/python -m uvicorn app.main:app --app-dir ../../backend --host 0.0.0.0 --port ${PORT:-8000}",
    "start": "bash ../../backend/ensure_venv.sh && APP_ENV=production exec ../../backend/.venv/bin/python -m uvicorn app.main:app --app-dir ../../backend --host 0.0.0.0 --port ${PORT:-8000}",
    "build": "bash ../../backend/ensure_venv.sh",
    "typecheck": "true"
  }
}
